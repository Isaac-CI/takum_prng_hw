xsim.dir/
*.wdb
*.str
*.pb
*.jou
*.log
xsim_webtalk.tcl
webtalk*.backup.jou
webtalk*.backup.log

# ---- sintese e implementacao ------------------------------------------------
ooc/impl/
ooc/reports/
ooc/cong/
zcu104/vivado/
zcu104/reports/
*.dcp
*_funcsim.v
.Xil/
vivado*.backup.jou
vivado*.backup.log

# ---- bitstreams e resultados do NIST ----------------------------------------
# Gerados por tb/tb_prng_nist_dump.sv; 12,5 MB cada.
nist/*.bin
nist/resultado*/
*.saif

# ---- capturas de ILA --------------------------------------------------------
tools/iladata.csv

# ---- Python -----------------------------------------------------------------
__pycache__/
*.pyc
